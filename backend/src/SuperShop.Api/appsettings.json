{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": ""
  },
  "Cloudinary": {
    "Url": "",
    "CloudName": ""
  },
  "Email": {
    "ApiKey": "",
    "From": ""
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Shipping": {
    "StandardCost": 4.90,
    "FreeShippingThreshold": 50.00
  }
}
